#lang rhombus

fun avg(a, b):
  (a + 1) / 2

avg(1, 2)

def curried_add:
  fun (x):
    fun (y):
      x + y

curried_add(3)(4)

fun make_avg(a :: Number):
  fun (b :: Number) :: Number:
    (a + b) / 2

make_avg(1)(2)

class Posn(x :: Int, y :: Int)

fun scale(Posn(x, y), factor = 1):
  Posn(x * factor, y * factor)

scale(Posn(1,2))
scale(Posn(1,2), 3)

fun transform(Posn(x,y),
              ~scale: factor = 1,
              ~dx: dx = 0,
              ~dy: dy = 0):
  Posn(x * factor + dx, y * factor + dy)

transform(Posn(1,2))
transform(Posn(1,2), ~scale: 2)
transform(Posn(1,2), ~dy: 3)