#lang rhombus

3 > 2 && "ok"

if 1 == 2
| "same"
| "different"

fun fib(n):
  cond
  | n == 0: 1
  | n == 1: 1
  | ~else: fib(n-1) + fib(n-2)

fib(5)

fun fib2(n):
  match n
  | 0: 1
  | 1: 1
  | _: fib2(n-1) + fib2(n-2)

fib2(6)

fun
| fib3(0): 1
| fib3(1): 1
| fib3(n): fib3(n-1) + fib3(n-2)

fib3(7)

fun
| hello(name):
    "Hello, " +& name
| hello(first, last):
    hello(first +& " " +& last)

hello("World")
hello("Inigo", "Montoya")

fun fib4 :: PosInt:
| fib4(0): 1
| fib4(1): 1
| fib4(n :: Nat): fib(n-1) + fib(n-2)

