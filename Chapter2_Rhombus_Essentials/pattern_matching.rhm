fun lists_equal(xs, ys):
  guard.let [x, & rest_xs] = xs | ys == []
  guard.let [y, & rest_ys] = ys | #false
  x == y && lists_equal(rest_xs, rest_ys)
  
lists_equal([1,2], [1,2])
lists_equal([1,2,3], [1,2])
  