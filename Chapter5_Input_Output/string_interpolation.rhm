#lang rhombus

@str{Hello}
@str{1 + 1 is @(1 + 1)}
@(3 + 4)
3 + 4
@List(1,2,3)
@str{1 + 1 is @math.sum(1,1)}
@str{Text within {} is
     not constrained to
     a single line}
@str|-{The example above: @str{1 + 1 is @(1 + 1).}}-|
@str{The key #'pi is mapped to @str.f(math.pi, ~precision: 2).}

fun pct(n): str.f(n * 100, ~precision: 1) ++ "%"
print(@str{Conents: @pct(0.251) apples
                    @pct(1/6) bananas
                    @pct(0.5) cherries})