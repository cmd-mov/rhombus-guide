#lang rhombus

def [x, ...] = [1, 2, 3]
[x, ..., 100]
[-x,...]

def [[z, ...], ...] = [[1, 2, 3], [5, 6]]
[[z, ..., 100], ...]

def [[a, ...], ...] = [[1, 2, 3], [5, 6], [7], []]
[[a, ..., -1], ...]
[a,...,...]
[[-a,...],...]

def [y,...] = [4, 5, 6]
[x+y, ...]

def [[r, ...], ...] = [[1, 2], [3, 4], [5, 6]]
def [q, ...] = ["a", "b"]
[[q +& r, ...], ...]

[x+1 ,...]
def five = 5
[x+five, ...]

[{x}, ...]
[{x: #true}, ...]

class Posn(x, y)
fun mirror(Posn(x, y)) :~ List.of(Posn):
  [Posn(x, y), Posn(y, x)]
def [p, ...] = [Posn(1, 2), Posn(3, 4), Posn(5, 6)]
['z + $(mirror(p)[1].x)', ...]